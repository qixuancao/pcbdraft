#!/usr/bin/env python3
"""Deterministic fake kicad-cli used only by offline integration tests."""

from __future__ import annotations

import json
import os
import re
import sys
from pathlib import Path


def marker(text: str, name: str) -> int:
    match = re.search(rf"{name}=(\d+)", text)
    return int(match.group(1)) if match else 0


if sys.argv[1:] == ["--version"]:
    print("10.0.5-fake")
    raise SystemExit(0)

args = sys.argv[1:]
if len(args) >= 3 and args[:3] == ["sch", "export", "netlist"]:
    try:
        output = Path(args[args.index("--output") + 1])
    except (ValueError, IndexError):
        raise SystemExit(64)
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(
        """<?xml version="1.0" encoding="UTF-8"?>
<export><design><sheet><title_block><title>Fixture</title><rev>1</rev></title_block></sheet></design>
<components><comp ref="R1"><value>1k</value><footprint>R_Test</footprint>
<fields><field name="Description">fixture resistor</field></fields>
<libsource lib="Device" part="R" description="Resistor"/></comp></components>
<nets><net code="1" name="GND"><node ref="R1" pin="1" pinfunction="~" pintype="passive"/></net></nets>
</export>
""",
        encoding="utf-8",
    )
    raise SystemExit(0)

if len(args) >= 3 and args[:3] == ["pcb", "export", "stats"]:
    try:
        output = Path(args[args.index("--output") + 1])
    except (ValueError, IndexError):
        raise SystemExit(64)
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(
        json.dumps({"board": {"has_outline": True, "width": "10 mm"}, "components": {"total": 1}}),
        encoding="utf-8",
    )
    raise SystemExit(0)

if len(args) >= 3 and args[:3] == ["pcb", "export", "ipcd356"]:
    try:
        output = Path(args[args.index("--output") + 1])
    except (ValueError, IndexError):
        raise SystemExit(64)
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text("P  CODE 00\n317GND              R1    -1    D0100PA00X+000000Y+000000\n999\n", encoding="utf-8")
    raise SystemExit(0)

if len(args) < 4 or args[:2] not in (["sch", "erc"], ["pcb", "drc"]):
    print("unsupported fake invocation", file=sys.stderr)
    raise SystemExit(64)

gate = "erc" if args[:2] == ["sch", "erc"] else "drc"
try:
    output = Path(args[args.index("--output") + 1])
    input_file = Path(args[-1])
except (ValueError, IndexError):
    raise SystemExit(64)

text = input_file.read_text(encoding="utf-8")
if f"{gate.upper()}_TOOL_FAIL" in text:
    print("simulated tool failure", file=sys.stderr)
    raise SystemExit(9)

errors = marker(text, f"{gate.upper()}_ERROR")
warnings = marker(text, f"{gate.upper()}_WARNING")
if gate == "drc" and os.environ.get("PCBDRAFT_FAKE_APPLY_REGRESSION") == "1":
    errors += 1
violations = [
    {"severity": "error", "type": f"fake_{gate}_error", "description": "fake error"}
    for _ in range(errors)
] + [
    {"severity": "warning", "type": f"fake_{gate}_warning", "description": "fake warning"}
    for _ in range(warnings)
]
document = {
    "$schema": f"https://schemas.kicad.org/{gate}.v1.json",
    "kicad_version": "10.0.5-fake",
    "violations": violations,
}
output.parent.mkdir(parents=True, exist_ok=True)
output.write_text(json.dumps(document), encoding="utf-8")
print(f"Found {len(violations)} violations")
raise SystemExit(0)
