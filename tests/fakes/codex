#!/usr/bin/env python3
"""Schema-aware fake Codex CLI used only by offline integration tests."""

from __future__ import annotations

import json
import sys
from pathlib import Path


if sys.argv[1:] == ["--version"]:
    print("codex-cli 0.147.0-fake")
    raise SystemExit(0)

args = sys.argv[1:]
required_pairs = {
    "--model": "gpt-5.6-sol",
    "--sandbox": "read-only",
}
for flag, expected in required_pairs.items():
    if flag not in args or args[args.index(flag) + 1] != expected:
        print(f"missing pinned {flag}", file=sys.stderr)
        raise SystemExit(65)
configs = [args[index + 1] for index, value in enumerate(args[:-1]) if value == "--config"]
for expected in (
    'model_reasoning_effort="max"',
    'service_tier="default"',
    "features.fast_mode=false",
    "features.hooks=false",
    "agents.enabled=false",
    "features.multi_agent=false",
    "features.multi_agent_v2=false",
    "features.apps=false",
    "features.browser_use=false",
    "features.computer_use=false",
    "features.image_generation=false",
    "features.plugins=false",
    "features.skill_search=false",
    "features.tool_suggest=false",
    "tools.web_search=false",
    'approval_policy="never"',
    "allow_login_shell=false",
):
    if expected not in configs:
        print(f"missing config {expected}", file=sys.stderr)
        raise SystemExit(65)
if args[-1] != "-":
    print("prompt was not routed through stdin", file=sys.stderr)
    raise SystemExit(65)

prompt = sys.stdin.read()
if "SECURITY BOUNDARY" not in prompt or "untrusted data" not in prompt:
    print("prompt trust boundary missing", file=sys.stderr)
    raise SystemExit(65)
schema_path = Path(args[args.index("--output-schema") + 1])
last_path = Path(args[args.index("--output-last-message") + 1])
schema = json.loads(schema_path.read_text(encoding="utf-8"))

if "risk" in schema["properties"]:
    value = {
        "summary": "Fake read-only heuristic review.",
        "risk": "unknown",
        "modules": ["test module"],
        "interfaces": [],
        "power_domains": [],
        "missing_constraints": ["functional intent is not encoded"],
        "findings": [
            {
                "severity": "info",
                "category": "test",
                "title": "Fixture finding",
                "evidence": ["demo.kicad_pcb: OLD"],
                "rationale": "Exercises the structured review path.",
                "proposed_action": "Human review.",
                "confidence": 0.5,
                "requires_human": True,
            }
        ],
        "unsupported_checks": ["SI", "PI", "thermal", "EMI", "functional correctness"],
    }
else:
    boards = sorted(Path.cwd().glob("*.kicad_pcb"))
    if len(boards) != 1:
        print("fixture expects exactly one board", file=sys.stderr)
        raise SystemExit(65)
    old_text = "OLD"
    new_text = "NEW"
    if "CAUSE_REGRESSION" in prompt:
        old_text = "DRC_ERROR=0\nDRC_WARNING=2\nOLD"
        new_text = "DRC_ERROR=1\nDRC_WARNING=2\nNEW"
    value = {
        "summary": "Replace the unique fixture marker.",
        "operations": [
            {
                "op": "replace_text",
                "relative_path": boards[0].name,
                "old_text": old_text,
                "new_text": new_text,
                "reason": "Offline end-to-end fixture change.",
            }
        ],
        "unsupported_checks": ["functional correctness"],
    }

last_path.write_text(json.dumps(value), encoding="utf-8")
print(json.dumps({"type": "thread.started", "thread_id": "fake"}))
print(json.dumps({"type": "turn.completed"}))
raise SystemExit(0)
