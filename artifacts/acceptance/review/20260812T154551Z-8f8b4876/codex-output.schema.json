{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string"
          },
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "evidence": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "proposed_action": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "requires_human": {
            "type": "boolean"
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ],
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "category",
          "title",
          "evidence",
          "rationale",
          "proposed_action",
          "confidence",
          "requires_human"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "interfaces": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "missing_constraints": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "modules": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "power_domains": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical",
        "unknown"
      ],
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "unsupported_checks": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "summary",
    "risk",
    "modules",
    "interfaces",
    "power_domains",
    "missing_constraints",
    "findings",
    "unsupported_checks"
  ],
  "type": "object"
}
