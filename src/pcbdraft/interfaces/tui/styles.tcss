/*
   PCBDraft's semantic theme mirrors the copper-and-solder palette used by the
   brand mark and web UI. Copper identifies actions, green carries navigation,
   and success / warning / error retain distinct state colors.
*/

Screen {
    background: $pcb-background;
    color: $pcb-text;
}

#agent-header {
    height: 2;
    padding: 0 2;
    background: $pcb-surface;
    border-bottom: solid $pcb-border;
}

#main-area {
    height: 1fr;
    background: $pcb-background;
}

#transcript {
    width: 1fr;
    height: 1fr;
    padding: 1 3;
    scrollbar-size-vertical: 1;
    scrollbar-color: $scrollbar;
    scrollbar-color-hover: $scrollbar-hover;
    scrollbar-background: $pcb-background;
}

#transcript-content,
#rail-content {
    width: 1fr;
    height: auto;
}

#project-rail {
    width: 34;
    min-width: 32;
    height: 1fr;
    padding: 1 2;
    background: $pcb-surface;
    border-left: solid $pcb-border;
    scrollbar-size-vertical: 1;
    scrollbar-color: $scrollbar;
    scrollbar-background: $pcb-surface;
}

#composer {
    height: 4;
    padding: 0 2;
    background: $pcb-background;
}

#composer-surface {
    height: 4;
    padding: 0 1;
    background: $pcb-panel;
    border-left: thick $pcb-brand;
    border-bottom: solid $pcb-border;
}

#composer-row {
    height: 2;
}

#composer-prompt {
    width: 2;
    height: 1;
    margin-top: 1;
    color: $pcb-brand;
    text-style: bold;
}

#composer-input {
    width: 1fr;
    height: 1;
    margin-top: 1;
    padding: 0;
    border: none;
    background: $pcb-panel;
    color: $pcb-text-strong;
}

#composer-input:focus {
    border: none;
    background: $pcb-panel;
}

#composer-input > .input--cursor {
    background: $input-cursor-background;
    color: $input-cursor-foreground;
    text-style: bold;
}

#composer-input > .input--placeholder {
    color: $pcb-text-muted;
}

#composer-input > .input--selection {
    background: $pcb-input-selection;
    color: $pcb-text-strong;
}

#composer-meta {
    height: 1;
}

#composer-label {
    width: auto;
    height: 1;
    color: $pcb-brand;
    text-style: bold;
}

#composer-hint {
    width: 1fr;
    height: 1;
    color: $pcb-text-muted;
    text-align: right;
}

#composer.palette-open #composer-surface {
    border-left: thick $pcb-brand-soft;
}

#composer.palette-open #composer-hint {
    color: $pcb-text;
}

#composer.leader-active #composer-surface {
    border-left: thick $pcb-blue;
}

#composer.leader-active #composer-hint {
    color: $pcb-blue-soft;
}

#composer.composer-busy #composer-surface {
    border-left: thick $pcb-warning;
}

#composer.composer-busy #composer-prompt,
#composer.composer-busy #composer-label {
    color: $pcb-warning;
}

#composer.compact #composer-hint {
    display: none;
}

#notice-bar {
    height: auto;
    min-height: 1;
    max-height: 3;
    padding: 0 3;
    background: $pcb-background;
    color: $pcb-text-soft;
}

#notice-bar.notice-error {
    background: $pcb-error-surface;
    color: $pcb-error;
}

#notice-bar.notice-busy {
    color: $pcb-warning;
}

#app-footer {
    height: 1;
    padding: 0 2;
    background: $pcb-surface;
    color: $pcb-text-muted;
}

#command-palette {
    layer: overlay;
    dock: bottom;
    width: 1fr;
    height: auto;
    max-height: 12;
    margin: 0 3 6 3;
    padding: 0;
    background: $pcb-panel;
    border: round $pcb-border-strong;
    scrollbar-size-vertical: 1;
    scrollbar-color: $scrollbar;
    scrollbar-background: $pcb-panel;
}

#command-palette > .option-list--option {
    padding: 0 1;
    color: $pcb-text-soft;
}

#command-palette > .option-list--option-highlighted {
    padding: 0 1;
    background: $pcb-selection;
    color: $pcb-text-strong;
    text-style: bold;
}

#command-palette > .option-list--option-hover {
    background: $pcb-selection-hover;
}

ProjectPickerScreen,
NewProjectScreen,
CommandPickerScreen,
ProviderPickerScreen,
ProviderConnectScreen,
ModelPickerScreen,
ReviewScreen,
ProjectDetailsScreen,
HelpScreen {
    align: center middle;
    background: $pcb-background-deep 88%;
}

.modal-card {
    width: 82;
    max-width: 92%;
    height: 75%;
    max-height: 34;
    padding: 1 2;
    background: $pcb-panel-raised;
    border: round $pcb-border-strong;
}

#project-picker-card {
    width: 78;
    max-width: 94%;
    height: 22;
    min-height: 16;
    max-height: 90%;
}

#project-picker-heading {
    height: 1;
}

ProjectPickerScreen.compact-picker .modal-subtitle {
    display: none;
}

#project-details-card {
    width: 70;
    max-width: 94%;
    height: 88%;
    max-height: 42;
}

#project-details-rail {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    background: $pcb-background;
    border: solid $pcb-border;
    scrollbar-size-vertical: 1;
    scrollbar-color: $scrollbar;
    scrollbar-background: $pcb-background;
}

.new-project-card {
    width: 88;
    height: auto;
    max-height: 92%;
}

NewProjectScreen.compact-modal .modal-subtitle,
NewProjectScreen.compact-modal .form-note,
NewProjectScreen.compact-modal .modal-hint {
    display: none;
}

NewProjectScreen.compact-modal .field-label {
    margin-top: 0;
}

NewProjectScreen.compact-modal .form-error {
    height: 1;
}

NewProjectScreen.compact-modal .modal-actions {
    height: 3;
    padding-top: 0;
}

.modal-title {
    height: 1;
    color: $pcb-text-strong;
    text-style: bold;
}

.modal-subtitle {
    height: 2;
    color: $pcb-text-soft;
}

.modal-hint {
    height: auto;
    min-height: 1;
    max-height: 2;
    color: $pcb-text-muted;
    text-align: right;
}

.modal-card OptionList {
    scrollbar-size-vertical: 1;
    scrollbar-color: $scrollbar;
    scrollbar-color-hover: $scrollbar-hover;
}

.modal-card OptionList > .option-list--option {
    padding: 0 1;
}

.modal-card OptionList:focus > .option-list--option-highlighted,
.modal-card OptionList > .option-list--option-highlighted {
    color: $pcb-text-strong;
    background: $pcb-selection;
    text-style: bold;
}

.modal-card OptionList > .option-list--option-hover {
    background: $pcb-selection-hover;
}

#projects-list,
#commands-list,
#provider-list,
#models-list,
#review-scroll,
#help-scroll {
    height: 1fr;
    background: $pcb-background;
    border: solid $pcb-border;
    scrollbar-color: $scrollbar;
    scrollbar-background: $pcb-background;
}

#projects-list {
    min-height: 4;
    margin-top: 1;
}

#projects-list:focus {
    border: solid $pcb-border-strong;
}

#provider-form-scroll {
    height: 1fr;
    padding-right: 1;
    scrollbar-size-vertical: 1;
    scrollbar-color: $scrollbar;
    scrollbar-background: $pcb-panel-raised;
}

.provider-picker-card,
.provider-form-card,
.model-picker-card,
.command-picker-card {
    width: 88;
}

.provider-picker-card {
    height: 76%;
    max-height: 32;
}

.provider-form-card {
    height: 90%;
    max-height: 36;
}

.model-picker-card {
    height: 72%;
    max-height: 34;
}

.command-picker-card {
    height: 72%;
    max-height: 32;
}

.field-label {
    height: 1;
    margin-top: 1;
    color: $pcb-text;
    text-style: bold;
}

#provider-base-url,
#provider-model,
#provider-api-key,
#provider-id,
#provider-name,
#new-project-name,
#project-filter,
#model-filter,
#command-filter {
    height: 3;
    margin-bottom: 0;
    border: solid $pcb-border;
    background: $pcb-background;
    color: $pcb-text-strong;
}

#provider-base-url:focus,
#provider-model:focus,
#provider-api-key:focus,
#provider-id:focus,
#provider-name:focus,
#new-project-name:focus,
#project-filter:focus,
#model-filter:focus,
#command-filter:focus {
    border: solid $pcb-brand;
}

#empty-project-list {
    color: $pcb-warning;
}

.form-note {
    height: auto;
    margin-top: 1;
    color: $pcb-text-soft;
}

.form-error {
    height: 2;
    color: $pcb-error;
}

.modal-actions {
    height: 3;
    align-horizontal: right;
    padding-top: 1;
}

.modal-actions Button {
    min-width: 16;
    margin-left: 1;
    background: $pcb-panel;
    color: $pcb-text;
    border: none;
}

.modal-actions Button:focus {
    background: $pcb-selection;
    color: $pcb-text-strong;
    text-style: bold;
}

#create-project,
#review-confirm {
    background: $pcb-brand;
    color: $pcb-background;
    text-style: bold;
}

#create-project:focus,
#review-confirm:focus {
    background: $pcb-brand-soft;
    color: $pcb-background;
}

#review-discard {
    color: $pcb-warning;
}

#model-connect {
    min-width: 20;
}

#models-list,
#commands-list {
    height: 1fr;
}

#review-content,
#help-content {
    width: 1fr;
    height: auto;
    padding: 1;
}
