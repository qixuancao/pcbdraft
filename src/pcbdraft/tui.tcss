Screen {
    background: #0b0f17;
    color: #d9e2f2;
}

#agent-header {
    height: 3;
    padding: 0 2;
    background: #101722;
    border-bottom: solid #2a3a55;
}

#main-area {
    height: 1fr;
    background: #0b0f17;
}

#transcript {
    width: 1fr;
    height: 1fr;
    padding: 1 3;
    scrollbar-color: #3b4a66;
    scrollbar-color-hover: #597092;
    scrollbar-background: #0b0f17;
}

#transcript:focus {
    border: none;
}

#transcript-content {
    width: 1fr;
    height: auto;
}

#project-rail {
    width: 38;
    min-width: 34;
    height: 1fr;
    padding: 1 2;
    background: #0e141e;
    border-left: solid #2a3a55;
    scrollbar-color: #3b4a66;
    scrollbar-background: #0e141e;
}

#rail-content {
    width: 1fr;
    height: auto;
}

#notice-bar {
    height: auto;
    min-height: 1;
    max-height: 3;
    padding: 0 2;
    background: #0f1621;
    color: #8491ac;
    border-top: solid #24334b;
}

#notice-bar.notice-error {
    background: #28141b;
    color: #ff9aa5;
    border-top: solid #6f2f3c;
}

#notice-bar.notice-busy {
    color: #b8dcff;
    border-top: solid #315a77;
}

#composer {
    height: 4;
    padding: 0 1;
    background: #101722;
    border-top: solid #2a3a55;
}

#composer-row {
    height: 2;
}

#composer-label {
    width: 16;
    height: 1;
    margin: 1 1 0 1;
    color: #7dd3fc;
    text-style: bold;
}

#composer-input {
    width: 1fr;
    height: 3;
    border: round #30425d;
    background: #0c1420;
    color: #f1f5ff;
    padding: 0 1;
}

#composer-input:focus {
    border: round #5d9fd1;
    background: #111d2d;
}

#composer-hint {
    height: 1;
    margin: 0 1;
    color: #5f6c87;
}

Footer {
    height: 1;
    background: #0a0e15;
    color: #8190ac;
}

#command-palette {
    layer: overlay;
    dock: bottom;
    width: 72;
    max-width: 90%;
    height: auto;
    max-height: 18;
    margin: 0 2 5 18;
    padding: 0 1;
    background: #121a27;
    border: round #405171;
    scrollbar-color: #4b5e80;
    scrollbar-background: #121a27;
}

#command-palette > .option-list--option-highlighted {
    background: #263b55;
    color: #f3f7ff;
    text-style: bold;
}

ProjectPickerScreen,
ProviderPickerScreen,
ProviderConnectScreen,
ModelPickerScreen,
ReviewScreen,
HelpScreen {
    align: center middle;
    background: #080b11 82%;
}

.modal-card {
    width: 82;
    max-width: 92%;
    height: 75%;
    max-height: 34;
    padding: 1 2;
    background: #111925;
    border: round #466183;
}

#project-picker-card {
    height: auto;
    min-height: 12;
    max-height: 30;
}

.modal-title {
    height: 2;
    color: #eef4ff;
    text-style: bold;
}

.modal-subtitle {
    height: 2;
    color: #8794af;
}

.modal-hint {
    height: 1;
    color: #64718c;
    text-align: right;
}

.modal-card OptionList {
    scrollbar-color: #4b6388;
    scrollbar-color-hover: #6d8db7;
}

.modal-card OptionList > .option-list--option {
    padding: 0 1;
}

.modal-card OptionList:focus > .option-list--option-highlighted {
    color: #f4f8ff;
    background: #2a5277;
    text-style: bold;
}

#projects-list,
#provider-list,
#models-list,
#review-scroll,
#help-scroll {
    height: 1fr;
    background: #0e1520;
    border: solid #273247;
    scrollbar-color: #435574;
    scrollbar-background: #0e1520;
}

.provider-picker-card,
.provider-form-card,
.model-picker-card {
    width: 88;
}

.provider-picker-card {
    height: 76%;
    max-height: 32;
}

.provider-form-card {
    height: auto;
    max-height: 34;
}

.model-picker-card {
    height: 72%;
    max-height: 34;
}

.field-label {
    height: 1;
    margin-top: 1;
    color: #91a2bf;
    text-style: bold;
}

#provider-base-url,
#provider-model,
#provider-api-key,
#provider-id,
#provider-name,
#model-filter {
    height: 3;
    margin-bottom: 0;
    border: solid #35445d;
    background: #0c1420;
    color: #eef4ff;
}

#provider-base-url:focus,
#provider-model:focus,
#provider-api-key:focus,
#provider-id:focus,
#provider-name:focus,
#model-filter:focus {
    border: solid #6fa9d6;
}

.form-note {
    height: auto;
    margin-top: 1;
    color: #74839e;
}

.form-error {
    height: 2;
    color: #ff9aa5;
}

.modal-actions {
    height: 3;
    align-horizontal: right;
    padding-top: 1;
}

.modal-actions Button {
    min-width: 16;
    margin-left: 1;
}

.modal-actions Button:focus {
    text-style: bold;
}

#model-connect {
    min-width: 20;
}

#models-list {
    height: 1fr;
}

#review-content,
#help-content {
    width: 1fr;
    height: auto;
    padding: 1;
}
