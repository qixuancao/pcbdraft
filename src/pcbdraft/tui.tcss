Screen {
    background: #0a0d11;
    color: #d9dde3;
}

#agent-header {
    height: 2;
    padding: 0 2;
    background: #0d1116;
    border-bottom: solid #252c34;
}

#main-area {
    height: 1fr;
    background: #0a0d11;
}

#transcript {
    width: 1fr;
    height: 1fr;
    padding: 1 3;
    scrollbar-size-vertical: 1;
    scrollbar-color: #353e49;
    scrollbar-color-hover: #5a6674;
    scrollbar-background: #0a0d11;
}

#transcript-content {
    width: 1fr;
    height: auto;
}

#project-rail {
    width: 34;
    min-width: 32;
    height: 1fr;
    padding: 1 2;
    background: #0d1116;
    border-left: solid #252c34;
    scrollbar-size-vertical: 1;
    scrollbar-color: #353e49;
    scrollbar-background: #0d1116;
}

#rail-content {
    width: 1fr;
    height: auto;
}

#composer {
    height: 4;
    padding: 0 2;
    background: #0a0d11;
}

#composer-surface {
    height: 4;
    padding: 0 1;
    background: #141920;
    border-left: thick #e2a06b;
    border-bottom: solid #0d1116;
}

#composer-row {
    height: 2;
}

#composer-prompt {
    width: 2;
    height: 1;
    margin-top: 1;
    color: #e2a06b;
    text-style: bold;
}

#composer-input {
    width: 1fr;
    height: 1;
    margin-top: 1;
    padding: 0;
    border: none;
    background: #141920;
    color: #eef0f3;
}

#composer-input:focus {
    border: none;
    background: #141920;
}

#composer-input > .input--cursor {
    background: #f0b47e;
    color: #11151a;
    text-style: bold;
}

#composer-input > .input--placeholder {
    color: #636d7a;
}

#composer-input > .input--selection {
    background: #74543c;
    color: #ffffff;
}

#composer-meta {
    height: 1;
}

#composer-label {
    width: auto;
    height: 1;
    color: #b27d57;
    text-style: bold;
}

#composer-hint {
    width: 1fr;
    height: 1;
    color: #626b78;
    text-align: right;
}

#composer.palette-open #composer-surface {
    border-left: thick #f0b47e;
}

#composer.palette-open #composer-hint {
    color: #9ba3ae;
}

#composer.leader-active #composer-surface {
    border-left: thick #7db6d8;
}

#composer.leader-active #composer-hint {
    color: #a9cbe0;
}

#composer.composer-busy #composer-surface {
    border-left: thick #d9b968;
}

#composer.composer-busy #composer-prompt,
#composer.composer-busy #composer-label {
    color: #d9b968;
}

#notice-bar {
    height: 1;
    padding: 0 3;
    background: #0a0d11;
    color: #747d89;
}

#notice-bar.notice-error {
    background: #241417;
    color: #ef9294;
}

#notice-bar.notice-busy {
    color: #d9b968;
}

#app-footer {
    height: 1;
    padding: 0 2;
    background: #080a0d;
    color: #646d79;
}

#command-palette {
    layer: overlay;
    dock: bottom;
    width: 1fr;
    height: auto;
    max-height: 12;
    margin: 0 3 6 3;
    padding: 0;
    background: #171c23;
    border: round #3a444f;
    scrollbar-size-vertical: 1;
    scrollbar-color: #56616e;
    scrollbar-background: #171c23;
}

#command-palette > .option-list--option {
    padding: 0 1;
    color: #858e9a;
}

#command-palette > .option-list--option-highlighted {
    padding: 0 1;
    background: #493727;
    color: #f4f1ed;
    text-style: bold;
}

#command-palette > .option-list--option-hover {
    background: #242b34;
}

ProjectPickerScreen,
CommandPickerScreen,
ProviderPickerScreen,
ProviderConnectScreen,
ModelPickerScreen,
ReviewScreen,
HelpScreen {
    align: center middle;
    background: #06080b 84%;
}

.modal-card {
    width: 82;
    max-width: 92%;
    height: 75%;
    max-height: 34;
    padding: 1 2;
    background: #131820;
    border: round #3d4854;
}

#project-picker-card {
    height: auto;
    min-height: 12;
    max-height: 30;
}

.modal-title {
    height: 2;
    color: #eef0f3;
    text-style: bold;
}

.modal-subtitle {
    height: 2;
    color: #858e9a;
}

.modal-hint {
    height: 1;
    color: #646d79;
    text-align: right;
}

.modal-card OptionList {
    scrollbar-size-vertical: 1;
    scrollbar-color: #505c69;
    scrollbar-color-hover: #6b7887;
}

.modal-card OptionList > .option-list--option {
    padding: 0 1;
}

.modal-card OptionList:focus > .option-list--option-highlighted,
.modal-card OptionList > .option-list--option-highlighted {
    color: #f5f1ed;
    background: #493727;
    text-style: bold;
}

#projects-list,
#commands-list,
#provider-list,
#models-list,
#review-scroll,
#help-scroll {
    height: 1fr;
    background: #0d1218;
    border: solid #29313a;
    scrollbar-color: #444f5b;
    scrollbar-background: #0d1218;
}

.provider-picker-card,
.provider-form-card,
.model-picker-card,
.command-picker-card {
    width: 88;
}

.provider-picker-card {
    height: 76%;
    max-height: 32;
}

.provider-form-card {
    height: auto;
    max-height: 34;
}

.model-picker-card {
    height: 72%;
    max-height: 34;
}

.command-picker-card {
    height: 72%;
    max-height: 32;
}

.field-label {
    height: 1;
    margin-top: 1;
    color: #a3aab4;
    text-style: bold;
}

#provider-base-url,
#provider-model,
#provider-api-key,
#provider-id,
#provider-name,
#model-filter,
#command-filter {
    height: 3;
    margin-bottom: 0;
    border: solid #333d48;
    background: #0d1218;
    color: #eef0f3;
}

#provider-base-url:focus,
#provider-model:focus,
#provider-api-key:focus,
#provider-id:focus,
#provider-name:focus,
#model-filter:focus,
#command-filter:focus {
    border: solid #b27d57;
}

.form-note {
    height: auto;
    margin-top: 1;
    color: #737c88;
}

.form-error {
    height: 2;
    color: #ef9294;
}

.modal-actions {
    height: 3;
    align-horizontal: right;
    padding-top: 1;
}

.modal-actions Button {
    min-width: 16;
    margin-left: 1;
}

.modal-actions Button:focus {
    text-style: bold;
}

#model-connect {
    min-width: 20;
}

#models-list {
    height: 1fr;
}

#commands-list {
    height: 1fr;
}

#review-content,
#help-content {
    width: 1fr;
    height: auto;
    padding: 1;
}
