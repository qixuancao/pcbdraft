{
  "schema": "pcbdraft-circuit-plan",
  "version": 1,
  "design_id": "i2c-pullup-adapter",
  "summary": "Two four-pin I2C connectors and one pull-up resistor per bus signal.",
  "assumptions": ["No conflicting pull-ups are installed elsewhere on the bus."],
  "components": [
    {
      "id": "upstream",
      "reference": "J1",
      "symbol": "Connector_Generic:Conn_01x04",
      "value": "I2C_UPSTREAM",
      "role": "power_input_i2c_connector",
      "footprint": "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical",
      "on_board": true,
      "exact_name": null
    },
    {
      "id": "downstream",
      "reference": "J2",
      "symbol": "Connector_Generic:Conn_01x04",
      "value": "I2C_DOWNSTREAM",
      "role": "i2c_output_connector",
      "footprint": "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical",
      "on_board": true,
      "exact_name": null
    },
    {
      "id": "sda_pullup",
      "reference": "R1",
      "symbol": "Device:R",
      "value": "4.7k",
      "role": "i2c_sda_pullup",
      "footprint": "Resistor_SMD:R_0603_1608Metric",
      "on_board": true,
      "exact_name": null
    },
    {
      "id": "scl_pullup",
      "reference": "R2",
      "symbol": "Device:R",
      "value": "4.7k",
      "role": "i2c_scl_pullup",
      "footprint": "Resistor_SMD:R_0603_1608Metric",
      "on_board": true,
      "exact_name": null
    }
  ],
  "nets": [
    {
      "id": "v3v3",
      "name": "3V3",
      "net_class": "power",
      "intent": "Regulated pull-up supply.",
      "endpoints": [
        {"component": "upstream", "pin": "1", "role": "source"},
        {"component": "downstream", "pin": "1", "role": "load"},
        {"component": "sda_pullup", "pin": "1", "role": "load"},
        {"component": "scl_pullup", "pin": "1", "role": "load"}
      ]
    },
    {
      "id": "i2c_sda",
      "name": "I2C_SDA",
      "net_class": "signal",
      "intent": "Bidirectional I2C data with an explicit pull-up.",
      "endpoints": [
        {"component": "upstream", "pin": "2", "role": "bus"},
        {"component": "downstream", "pin": "2", "role": "bus"},
        {"component": "sda_pullup", "pin": "2", "role": "pullup"}
      ]
    },
    {
      "id": "i2c_scl",
      "name": "I2C_SCL",
      "net_class": "signal",
      "intent": "I2C clock with an explicit pull-up.",
      "endpoints": [
        {"component": "upstream", "pin": "3", "role": "bus"},
        {"component": "downstream", "pin": "3", "role": "bus"},
        {"component": "scl_pullup", "pin": "2", "role": "pullup"}
      ]
    },
    {
      "id": "gnd",
      "name": "GND",
      "net_class": "power",
      "intent": "Common I2C return.",
      "endpoints": [
        {"component": "upstream", "pin": "4", "role": "return"},
        {"component": "downstream", "pin": "4", "role": "return"}
      ]
    }
  ],
  "notes": ["Pull-up resistance and total bus capacitance require review."]
}
