{
  "board": {
    "edge_clearance_mm": 0.5,
    "finish": "hasl_lead_free",
    "height_mm": 30.0,
    "layers": 2,
    "min_clearance_mm": 0.1,
    "min_drill_mm": 0.3,
    "min_track_mm": 0.2,
    "thickness_mm": 1.6,
    "width_mm": 45.0
  },
  "design_id": "copperwright_i2c_temperature_controller",
  "functions": [
    {
      "id": "controller",
      "intent": "Run deterministic sensor acquisition and status firmware.",
      "kind": "microcontroller",
      "parameters": {
        "programming": "updi"
      }
    },
    {
      "id": "external_bus",
      "intent": "Accept regulated 3.3 V and expose the sensor bus on a JST-SH connector.",
      "kind": "i2c_connector",
      "parameters": {
        "pin_order": [
          "GND",
          "3V3",
          "SDA",
          "SCL"
        ]
      }
    },
    {
      "id": "programming",
      "intent": "Expose UPDI, target-voltage sense, and ground on a serviceable header.",
      "kind": "updi_programming",
      "parameters": {
        "connector_pitch_mm": 2.54,
        "power_pin_mode": "target_voltage_sense_only"
      }
    },
    {
      "id": "status",
      "intent": "Expose a current-limited green status indication.",
      "kind": "status_indicator",
      "parameters": {
        "color": "green"
      }
    },
    {
      "id": "temperature",
      "intent": "Measure local board temperature over I2C.",
      "kind": "temperature_sensor",
      "parameters": {
        "accuracy_class": "general_purpose"
      }
    }
  ],
  "interfaces": [
    {
      "bus_capacitance_pf_max": 200,
      "external_connector": true,
      "external_pullups": "forbidden",
      "id": "sensor_i2c",
      "kind": "i2c",
      "speed_hz": 100000
    }
  ],
  "name": "CopperWright I2C temperature controller",
  "power": {
    "max_current_a": 0.1,
    "max_v": 3.465,
    "min_v": 3.0,
    "nominal_v": 3.3
  },
  "priorities": [
    "electrical_correctness",
    "manufacturability",
    "compact_sensor_group"
  ],
  "revision": "1.0",
  "schema": "copperwright-requirements",
  "scope": {
    "domains": [
      "i2c",
      "low_voltage_mcu",
      "sensor",
      "simple_control"
    ],
    "intended_use": "Non-safety-critical low-voltage sensing/control prototype.",
    "layers": 2,
    "max_current_a": 0.1,
    "max_power_w": 0.3465,
    "max_voltage_v": 3.465,
    "risk_class": "prototype"
  },
  "source": {
