include LICENSE NOTICE README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md
include Makefile pcbdraft uv.lock
recursive-include constraints *.txt
recursive-include docs *.md *.png *.svg
recursive-include scripts *.sh *.py
recursive-include tests *.py
recursive-include src/pcbdraft/data *.json *.md
recursive-include src/pcbdraft/data/licenses *.txt
recursive-include src/pcbdraft/interfaces/tui *.yaml *.yml *.json
recursive-include src/pcbdraft/model *.yaml *.yml *.json
recursive-include src/pcbdraft/agent *.yaml *.yml *.json
recursive-include src/pcbdraft/agent/extensions *.yaml *.yml *.json
recursive-include src/pcbdraft/tools *.yaml *.yml *.json *.wav *.onnx *.tflite
recursive-include src/pcbdraft/web *.html *.css *.js
prune artifacts
global-exclude *.py[cod] __pycache__ *.kicad_prl
